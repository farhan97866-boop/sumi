type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type NoteView = 
 record {
   body: text;
   createdAt: Timestamp;
   id: nat;
   pinned: bool;
   title: text;
   updatedAt: Timestamp;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createNote: (title: text, body: text) -> (NoteView);
  deleteNote: (id: nat) -> (bool);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getChineseLearned: () -> (vec text) query;
  getChineseProgress: () -> (nat) query;
  getJapaneseLearned: (setId: text) -> (vec text) query;
  getJapaneseProgress: (setId: text) -> (nat) query;
  getNote: (id: nat) -> (opt NoteView) query;
  isCallerAdmin: () -> (bool) query;
  listNotes: (search: opt text) -> (vec NoteView) query;
  markChineseLearned: (character: text, learned: bool) -> ();
  markJapaneseLearned: (setId: text, character: text, learned: bool) -> ();
  schema: () -> (text) query;
  setNotePinned: (id: nat, pinned: bool) -> (opt NoteView);
  updateNote: (id: nat, title: text, body: text) -> (opt NoteView);
}
